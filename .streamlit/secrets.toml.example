# Streamlit secrets template — copy this file to secrets.toml and fill in real values.
# secrets.toml is listed in .gitignore and must NEVER be committed.

# Secret API key shared between the Streamlit frontend and the backend API server.
# Set the same value as the API_KEY environment variable on the backend.
API_KEY = "change-me-to-a-strong-random-secret"

# Full base URL of the backend API server (no trailing slash).
# Example: "http://203.0.113.42:8000"
API_URL = "http://your-server-ip:8000"
